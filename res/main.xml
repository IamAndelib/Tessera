<?xml version="1.0" encoding="UTF-8"?>
<kcfg xmlns="http://www.kde.org/standards/kcfg/1.0">
    <kcfgfile name=""/>
    <group name="">
        <entry name="FilterProcess" type="string"><default>krunner, yakuake, kded, polkit, plasmashell</default></entry>
        <entry name="FilterCaption" type="string"><default></default></entry>
        <entry name="TilePopups" type="bool"><default>false</default></entry>

        <entry name="TiledWindowStacking" type="int"><default>2</default></entry>
        <entry name="MaximizeSingle" type="bool"><default>false</default></entry>
        <entry name="MaxTiledWindows" type="int"><default>5</default></entry>
        <entry name="MaxTiledWindowsPerHalf" type="int"><default>4</default></entry>
        <entry name="InsertionPoint" type="int"><default>1</default></entry>
        <entry name="RotateLayout" type="bool"><default>false</default></entry>
        <entry name="AutoRotateLayout" type="bool"><default>true</default></entry>
        <!-- Hyprland-style dwindle options -->
        <entry name="PreserveSplit" type="bool"><default>false</default></entry>
        <entry name="ForceSplit" type="int"><default>0</default></entry>
        <!-- Debug logging -->
        <entry name="Debug" type="bool"><default>false</default></entry>
    </group>
</kcfg>
